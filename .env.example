# Your Oumi API key (Settings > API Keys in the web app)
OUMI_API_KEY=
# Oumi API base URL for your environment
OUMI_API_URL=https://api.oumi.ai/v1
# Project ID from the web app URL
OUMI_PROJECT_ID=
# Optional: Oumi web app base URL, used only to print a link to your evaluations
OUMI_WEB_URL=
# Password the platform sends to the tool server; generate one (see README)
TOOL_SERVER_API_KEY=
# Public HTTPS URL of the tool server (the Cloudflare tunnel URL)
TOOL_SERVER_URL=
